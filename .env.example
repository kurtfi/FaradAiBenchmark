# ==============================================================================
# Faraday Laya Guard — Environment Variables Template (.env.example)
# ==============================================================================

# Hugging Face Access Token
# Required for gated Hugging Face repositories (e.g., Llama Guard 3, ShieldGemma).
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Hardware & Memory Management (Apple Silicon / MLX)
# Caps MLX Metal cache allocator to avoid claiming unbounded system RAM (in MB)
MLX_MEMORY_LIMIT_MB=1024

# Database & File Paths
BENCHMARK_DB_PATH=data/benchmark_runs.duckdb
MASTER_DATASET_PATH=data/processed/master_benchmark.parquet

# Web Dashboard Server Configuration
HOST=0.0.0.0
PORT=8765
DEBUG=false
