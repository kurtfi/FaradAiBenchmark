# ==============================================================================
# Faraday Laya Guard — Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================

# Hugging Face Erişim Belirteci
# Hugging Face üzerindeki izinli (gated) modeller (Llama Guard 3, ShieldGemma) için gereklidir.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Donanım & Bellek Ayarları (Apple Silicon / MLX)
# Metal unified memory sızıntılarını önlemek için MLX önbellek üst tavanı (MB cinsinden)
MLX_MEMORY_LIMIT_MB=1024

# Veritabanı ve Dosya Yolları
BENCHMARK_DB_PATH=data/benchmark_runs.duckdb
MASTER_DATASET_PATH=data/processed/master_benchmark.parquet

# Web Dashboard Sunucu Konfigürasyonu
HOST=0.0.0.0
PORT=8765
DEBUG=false
